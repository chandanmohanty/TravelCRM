{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Override in dotnet user-secrets (dev) or TRAVELCRM_ConnectionStrings__DefaultConnection env var (prod).
    // Keep this placeholder empty in source control.
    "DefaultConnection": ""
  },
  "Jwt": {
    // Override in dotnet user-secrets (dev) or TRAVELCRM_Jwt__SecretKey env var (prod).
    // Must be at least 32 characters (HS256).
    "SecretKey": "",
    "Issuer": "https://api.travelcrm.io",
    "Audience": "travelcrm-app",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:61322",
      "http://localhost:3000"
    ]
  },
  "FileStorage": {
    "BasePath": "uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "image/svg+xml",
      "image/webp",
      "image/x-icon",
      "image/vnd.microsoft.icon"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Mvc.Infrastructure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/travelcrm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "_SeqExample": "To ship to Seq, append { \"Name\": \"Seq\", \"Args\": { \"serverUrl\": \"http://localhost:5341\" } } to the WriteTo array."
  }
}
